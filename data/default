server {
        listen          443 ssl http2;
        server_name     scrapy2.duckdns.org;

    ssl_certificate             /root/scrapy2.duckdns.org.pem;
    ssl_certificate_key         /root/scrapy2.duckdns.org-key.pem;

        location / {
                proxy_pass https://schillerwg37.ddns.net:443;
                proxy_ssl_server_name on;
                proxy_ssl_name schillerwg37.ddns.net;

        # Standard proxy headers
            proxy_set_header Host schillerwg37.ddns.net;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
}

